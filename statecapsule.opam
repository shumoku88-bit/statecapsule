opam-version: "2.0"
version: "0.0.0"
synopsis: "Tiny inspectable state-machine experiments"
description: """
StateCapsule explores small single-purpose state machines in OCaml, with explicit
formal models and later MirageOS deployment experiments.
"""
maintainer: "StateCapsule maintainers"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.17"}
  "alcotest" {with-test}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: [
  ["dune" "runtest" "-p" name "-j" jobs]
]
