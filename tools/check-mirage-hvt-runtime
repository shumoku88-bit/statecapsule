#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

bridge="scbr0"
tap="sctap0"
host_ip="10.77.0.1"
guest_ip="10.77.0.2"
prefix="24"
port="18080"
base="http://$guest_ip:$port"
log="$(mktemp)"
state_file="$(mktemp)"
pid=""

cleanup() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi

  sudo ip link del "$bridge" 2>/dev/null || true
  sudo ip link del "$tap" 2>/dev/null || true
  rm -f "$log" "$state_file"
}
trap cleanup EXIT

if [[ ! -e /dev/kvm ]]; then
  echo "/dev/kvm is unavailable; hvt runtime cannot be qualified on this runner" >&2
  exit 1
fi

sudo chmod a+rw /dev/kvm

bash tools/build-mirage-hvt

sudo ip link add name "$bridge" type bridge
sudo ip addr add "$host_ip/$prefix" dev "$bridge"
sudo ip tuntap add dev "$tap" mode tap user "$(id -u)"
sudo ip link set "$tap" master "$bridge"
sudo ip link set "$tap" up
sudo ip link set "$bridge" up

artifact="mirage/dist/statecapsule-http.hvt"

opam exec -- solo5-hvt   --mem=64   --net:service="$tap"   -- "$artifact"   --ipv4="$guest_ip/$prefix"   --ipv4-gateway="$host_ip"   --port "$port"   >"$log" 2>&1 &
pid=$!

ready=false
for _ in $(seq 1 80); do
  if curl       --noproxy '*'       --silent       --show-error       --connect-timeout 1       "$base/state"       >"$state_file" 2>/dev/null; then
    ready=true
    break
  fi

  if ! kill -0 "$pid" 2>/dev/null; then
    echo "hvt unikernel exited before becoming ready" >&2
    cat "$log" >&2
    exit 1
  fi

  sleep 0.25
done

if [[ "$ready" != "true" ]]; then
  echo "hvt unikernel did not become ready" >&2
  cat "$log" >&2
  exit 1
fi

initial="$(cat "$state_file")"
if [[ "$initial" != '{"state":"locked"}' ]]; then
  echo "unexpected initial response: $initial" >&2
  exit 1
fi

missing_file="$(mktemp)"
missing_status="$(
  curl --noproxy '*' --silent --show-error     -o "$missing_file"     -w '%{http_code}'     -X POST     "$base/arm"
)"
missing="$(cat "$missing_file")"
rm -f "$missing_file"
if [[ "$missing_status" != "400" ]]; then
  echo "expected 400 without Idempotency-Key, got $missing_status" >&2
  exit 1
fi
if [[ "$missing" != '{"error":"missing_idempotency_key","current_state":"locked"}' ]]; then
  echo "unexpected missing-key response: $missing" >&2
  exit 1
fi

early_file="$(mktemp)"
early_status="$(
  curl --noproxy '*' --silent --show-error     -o "$early_file"     -w '%{http_code}'     -X POST     -H 'Idempotency-Key: too-early'     "$base/consume"
)"
early="$(cat "$early_file")"
rm -f "$early_file"
if [[ "$early_status" != "409" ]]; then
  echo "expected fresh refusal 409, got $early_status" >&2
  exit 1
fi
if [[ "$early" != '{"request":"fresh","outcome":{"kind":"refused","error":"not_armed"},"current_state":"locked"}' ]]; then
  echo "unexpected fresh refusal: $early" >&2
  exit 1
fi

armed="$(
  curl --noproxy '*' --silent --show-error     -X POST     -H 'Idempotency-Key: arm-1'     "$base/arm"
)"
if [[ "$armed" != '{"request":"fresh","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "unexpected fresh arm response: $armed" >&2
  exit 1
fi

early_replay_file="$(mktemp)"
early_replay_status="$(
  curl --noproxy '*' --silent --show-error     -o "$early_replay_file"     -w '%{http_code}'     -X POST     -H 'Idempotency-Key: too-early'     "$base/consume"
)"
early_replay="$(cat "$early_replay_file")"
rm -f "$early_replay_file"
if [[ "$early_replay_status" != "409" ]]; then
  echo "expected replay refusal 409, got $early_replay_status" >&2
  exit 1
fi
if [[ "$early_replay" != '{"request":"replay","outcome":{"kind":"refused","error":"not_armed"},"current_state":"armed"}' ]]; then
  echo "unexpected replay refusal: $early_replay" >&2
  exit 1
fi

arm_replay="$(
  curl --noproxy '*' --silent --show-error     -X POST     -H 'Idempotency-Key: arm-1'     "$base/arm"
)"
if [[ "$arm_replay" != '{"request":"replay","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "unexpected arm replay: $arm_replay" >&2
  exit 1
fi

conflict_file="$(mktemp)"
conflict_status="$(
  curl --noproxy '*' --silent --show-error     -o "$conflict_file"     -w '%{http_code}'     -X POST     -H 'Idempotency-Key: arm-1'     "$base/consume"
)"
conflict="$(cat "$conflict_file")"
rm -f "$conflict_file"
if [[ "$conflict_status" != "409" ]]; then
  echo "expected id conflict 409, got $conflict_status" >&2
  exit 1
fi
if [[ "$conflict" != '{"error":"id_conflict","current_state":"armed"}' ]]; then
  echo "unexpected id conflict response: $conflict" >&2
  exit 1
fi

used="$(
  curl --noproxy '*' --silent --show-error     -X POST     -H 'Idempotency-Key: consume-1'     "$base/consume"
)"
if [[ "$used" != '{"request":"fresh","outcome":{"kind":"applied","state":"used"},"current_state":"used"}' ]]; then
  echo "unexpected fresh consume response: $used" >&2
  exit 1
fi

used_replay="$(
  curl --noproxy '*' --silent --show-error     -X POST     -H 'Idempotency-Key: consume-1'     "$base/consume"
)"
if [[ "$used_replay" != '{"request":"replay","outcome":{"kind":"applied","state":"used"},"current_state":"used"}' ]]; then
  echo "unexpected consume replay: $used_replay" >&2
  exit 1
fi

final="$(curl --noproxy '*' --silent --show-error "$base/state")"
if [[ "$final" != '{"state":"used"}' ]]; then
  echo "unexpected final response: $final" >&2
  exit 1
fi

echo "Solo5 hvt HTTP idempotency smoke test: OK"
