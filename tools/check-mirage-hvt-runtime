#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

bridge="scbr0"
tap="sctap0"
host_ip="10.77.0.1"
guest_ip="10.77.0.2"
prefix="24"
port="18080"
base="http://$guest_ip:$port"
log="$(mktemp)"
state_file="$(mktemp)"
image="$(mktemp)"
pid=""
curl_pid=""

cleanup() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  sudo ip link del "$bridge" 2>/dev/null || true
  sudo ip link del "$tap" 2>/dev/null || true
  rm -f "$log" "$state_file" "$image"
}
trap cleanup EXIT

stop_guest() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    pid=""
  fi
}

fresh_image() {
  stop_guest
  bash tools/create-capsule-image "$image"
}

start_guest() {
  local failure_point="${1:-none}"
  : >"$log"

  opam exec -- solo5-hvt     --mem=64     --net:service="$tap"     --block:capsule="$image"     -- "$artifact"     --ipv4="$guest_ip/$prefix"     --ipv4-gateway="$host_ip"     --port "$port"     --failure-point "$failure_point"     >"$log" 2>&1 &
  pid=$!

  local ready=false
  for _ in $(seq 1 80); do
    if curl --noproxy '*' --silent --show-error --connect-timeout 1       "$base/state" >"$state_file" 2>/dev/null; then
      ready=true
      break
    fi

    if ! kill -0 "$pid" 2>/dev/null; then
      echo "hvt unikernel exited before becoming ready" >&2
      cat "$log" >&2
      exit 1
    fi

    sleep 0.25
  done

  if [[ "$ready" != "true" ]]; then
    echo "hvt unikernel did not become ready" >&2
    cat "$log" >&2
    exit 1
  fi
}

wait_for_failpoint() {
  local expected="$1"
  local marker="STATECAPSULE_FAILPOINT $expected"

  for _ in $(seq 1 80); do
    if grep -q "$marker" "$log"; then
      return 0
    fi

    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      echo "hvt guest exited before failpoint $expected" >&2
      cat "$log" >&2
      exit 1
    fi

    sleep 0.25
  done

  echo "did not observe failpoint $expected" >&2
  cat "$log" >&2
  exit 1
}

post_arm_in_background() {
  local request_id="$1"
  local output="$2"

  curl --noproxy '*' --silent --show-error --max-time 20     -o "$output"     -X POST     -H "Idempotency-Key: $request_id"     "$base/arm" &
  echo $!
}

expect_state_file() {
  local expected="$1"
  local actual
  actual="$(cat "$state_file")"

  if [[ "$actual" != "$expected" ]]; then
    echo "unexpected state response: $actual" >&2
    exit 1
  fi
}

if [[ ! -e /dev/kvm ]]; then
  echo "/dev/kvm is unavailable; hvt runtime cannot be qualified on this runner" >&2
  exit 1
fi

sudo chmod a+rw /dev/kvm

bash tools/build-mirage-hvt
opam install chamelon-unix
bash tools/create-capsule-image "$image"

sudo ip link add name "$bridge" type bridge
sudo ip addr add "$host_ip/$prefix" dev "$bridge"
sudo ip tuntap add dev "$tap" mode tap user "$(id -u)"
sudo ip link set "$tap" master "$bridge"
sudo ip link set "$tap" up
sudo ip link set "$bridge" up

artifact="mirage/dist/statecapsule-http.hvt"

# Ordinary durable replay / reboot path.
start_guest
expect_state_file '{"state":"locked"}'

early_file="$(mktemp)"
early_status="$(
  curl --noproxy '*' --silent --show-error     -o "$early_file" -w '%{http_code}'     -X POST -H 'Idempotency-Key: too-early' "$base/consume"
)"
early="$(cat "$early_file")"
rm -f "$early_file"
if [[ "$early_status" != "409" ]] ||
   [[ "$early" != '{"request":"fresh","outcome":{"kind":"refused","error":"not_armed"},"current_state":"locked"}' ]]; then
  echo "unexpected fresh refusal: $early_status $early" >&2
  exit 1
fi

armed="$(
  curl --noproxy '*' --silent --show-error     -X POST -H 'Idempotency-Key: arm-1' "$base/arm"
)"
if [[ "$armed" != '{"request":"fresh","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "unexpected fresh arm response: $armed" >&2
  exit 1
fi

stop_guest
start_guest
expect_state_file '{"state":"armed"}'

early_replay_file="$(mktemp)"
early_replay_status="$(
  curl --noproxy '*' --silent --show-error     -o "$early_replay_file" -w '%{http_code}'     -X POST -H 'Idempotency-Key: too-early' "$base/consume"
)"
early_replay="$(cat "$early_replay_file")"
rm -f "$early_replay_file"
if [[ "$early_replay_status" != "409" ]] ||
   [[ "$early_replay" != '{"request":"replay","outcome":{"kind":"refused","error":"not_armed"},"current_state":"armed"}' ]]; then
  echo "refusal receipt did not survive hvt reboot: $early_replay_status $early_replay" >&2
  exit 1
fi

arm_replay="$(
  curl --noproxy '*' --silent --show-error     -X POST -H 'Idempotency-Key: arm-1' "$base/arm"
)"
if [[ "$arm_replay" != '{"request":"replay","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "arm receipt did not survive hvt reboot: $arm_replay" >&2
  exit 1
fi

used="$(
  curl --noproxy '*' --silent --show-error     -X POST -H 'Idempotency-Key: consume-1' "$base/consume"
)"
if [[ "$used" != '{"request":"fresh","outcome":{"kind":"applied","state":"used"},"current_state":"used"}' ]]; then
  echo "unexpected fresh consume response: $used" >&2
  exit 1
fi

stop_guest
start_guest
expect_state_file '{"state":"used"}'

used_replay="$(
  curl --noproxy '*' --silent --show-error     -X POST -H 'Idempotency-Key: consume-1' "$base/consume"
)"
if [[ "$used_replay" != '{"request":"replay","outcome":{"kind":"applied","state":"used"},"current_state":"used"}' ]]; then
  echo "consume receipt did not survive hvt reboot: $used_replay" >&2
  exit 1
fi

# Malformed durable data must fail closed.
stop_guest
opam exec -- chamelon write "$image" 512 /capsule corrupt

: >"$log"
opam exec -- solo5-hvt   --mem=64   --net:service="$tap"   --block:capsule="$image"   -- "$artifact"   --ipv4="$guest_ip/$prefix"   --ipv4-gateway="$host_ip"   --port "$port"   >"$log" 2>&1 &
pid=$!

rejected=false
for _ in $(seq 1 40); do
  if ! kill -0 "$pid" 2>/dev/null; then
    rejected=true
    break
  fi

  if curl --noproxy '*' --silent --show-error --connect-timeout 1     "$base/state" >/dev/null 2>&1; then
    echo "hvt guest accepted a malformed persisted snapshot" >&2
    cat "$log" >&2
    exit 1
  fi

  sleep 0.25
done

if [[ "$rejected" != "true" ]]; then
  echo "hvt guest neither rejected malformed storage nor became ready" >&2
  cat "$log" >&2
  exit 1
fi

wait "$pid" 2>/dev/null || true
pid=""

if ! grep -q "invalid persisted capsule snapshot" "$log"; then
  echo "hvt guest failed closed, but not for the expected snapshot validation reason" >&2
  cat "$log" >&2
  exit 1
fi

# Crash before the concrete KV commit: candidate state/receipt must disappear.
fresh_image
start_guest before-commit
expect_state_file '{"state":"locked"}'

before_output="$(mktemp)"
post_arm_in_background crash-before "$before_output"
wait_for_failpoint before-commit
stop_guest
wait "$curl_pid" 2>/dev/null || true
curl_pid=""
rm -f "$before_output"

start_guest
expect_state_file '{"state":"locked"}'

before_retry="$(
  curl --noproxy '*' --silent --show-error     -X POST -H 'Idempotency-Key: crash-before' "$base/arm"
)"
if [[ "$before_retry" != '{"request":"fresh","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "pre-commit retry was not fresh after recovery: $before_retry" >&2
  exit 1
fi

# Crash after Store.set returned Ok but before visible state / HTTP publish:
# committed state and receipt must recover, and retry must replay.
fresh_image
start_guest after-commit-before-publish
expect_state_file '{"state":"locked"}'

after_output="$(mktemp)"
post_arm_in_background crash-after "$after_output"
wait_for_failpoint after-commit-before-publish
stop_guest
wait "$curl_pid" 2>/dev/null || true
curl_pid=""
rm -f "$after_output"

start_guest
expect_state_file '{"state":"armed"}'

after_retry="$(
  curl --noproxy '*' --silent --show-error     -X POST -H 'Idempotency-Key: crash-after' "$base/arm"
)"
if [[ "$after_retry" != '{"request":"replay","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "post-commit retry was not replay after recovery: $after_retry" >&2
  exit 1
fi

echo "Solo5 hvt durable replay/reboot/crash-boundary smoke test: OK"
