#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

port=18080
log="$(mktemp)"
state_file="$(mktemp)"
pid=""

cleanup() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  rm -f "$log" "$state_file"
}
trap cleanup EXIT

opam install .
opam install mirage.4.11.2

(
  cd mirage
  opam exec -- mirage configure -t unix --net socket
  opam exec -- make depends
  opam exec -- dune build
)

mirage/dist/statecapsule-http --port "$port" >"$log" 2>&1 &
pid=$!

ready=false
for _ in $(seq 1 40); do
  if curl --silent --show-error "http://127.0.0.1:$port/state" >"$state_file" 2>/dev/null; then
    ready=true
    break
  fi
  sleep 0.25
done

if [[ "$ready" != "true" ]]; then
  echo "MirageOS HTTP service did not become ready" >&2
  cat "$log" >&2
  exit 1
fi

initial="$(cat "$state_file")"
if [[ "$initial" != '{"state":"locked"}' ]]; then
  echo "unexpected initial response: $initial" >&2
  cat "$log" >&2
  exit 1
fi

armed="$(curl --silent --show-error -X POST "http://127.0.0.1:$port/arm")"
if [[ "$armed" != '{"state":"armed"}' ]]; then
  echo "unexpected arm response: $armed" >&2
  exit 1
fi

used="$(curl --silent --show-error -X POST "http://127.0.0.1:$port/consume")"
if [[ "$used" != '{"state":"used"}' ]]; then
  echo "unexpected consume response: $used" >&2
  exit 1
fi

refusal_file="$(mktemp)"
status="$(
  curl --silent --show-error     -o "$refusal_file"     -w '%{http_code}'     -X POST     "http://127.0.0.1:$port/consume"
)"
refusal="$(cat "$refusal_file")"
rm -f "$refusal_file"

if [[ "$status" != "409" ]]; then
  echo "expected 409 after terminal consume, got $status" >&2
  exit 1
fi

if [[ "$refusal" != '{"error":"already_used","state":"used"}' ]]; then
  echo "unexpected refusal response: $refusal" >&2
  exit 1
fi

final="$(curl --silent --show-error "http://127.0.0.1:$port/state")"
if [[ "$final" != '{"state":"used"}' ]]; then
  echo "unexpected final response: $final" >&2
  exit 1
fi

echo "MirageOS Unix HTTP smoke test: OK"
