#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

port=18080
base="http://127.0.0.1:$port"
image="$repo_root/capsule"
log="$(mktemp)"
state_file="$(mktemp)"
pid=""

cleanup() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  rm -f "$log" "$state_file" "$image"
}
trap cleanup EXIT

stop_service() {
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    pid=""
  fi
}

start_service() {
  : >"$log"
  mirage/dist/statecapsule-http --port "$port" >"$log" 2>&1 &
  pid=$!

  local ready=false
  for _ in $(seq 1 60); do
    if curl --silent --show-error "$base/state" >"$state_file" 2>/dev/null; then
      ready=true
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "MirageOS HTTP service exited before becoming ready" >&2
      cat "$log" >&2
      exit 1
    fi
    sleep 0.25
  done

  if [[ "$ready" != "true" ]]; then
    echo "MirageOS HTTP service did not become ready" >&2
    cat "$log" >&2
    exit 1
  fi
}

opam install .
opam install mirage.4.11.2 chamelon-unix

(
  cd mirage
  opam exec -- mirage configure -t unix --net socket
  opam exec -- make depends
  opam exec -- dune build
)

bash tools/create-capsule-image "$image"
start_service

initial="$(cat "$state_file")"
if [[ "$initial" != '{"state":"locked"}' ]]; then
  echo "unexpected initial response: $initial" >&2
  exit 1
fi

early_file="$(mktemp)"
early_status="$(
  curl --silent --show-error -o "$early_file" -w '%{http_code}'     -X POST -H 'Idempotency-Key: too-early' "$base/consume"
)"
early="$(cat "$early_file")"
rm -f "$early_file"
if [[ "$early_status" != "409" ]] ||
   [[ "$early" != '{"request":"fresh","outcome":{"kind":"refused","error":"not_armed"},"current_state":"locked"}' ]]; then
  echo "unexpected fresh refusal after initial boot: $early_status $early" >&2
  exit 1
fi

armed="$(
  curl --silent --show-error -X POST     -H 'Idempotency-Key: arm-1' "$base/arm"
)"
if [[ "$armed" != '{"request":"fresh","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "unexpected fresh arm response: $armed" >&2
  exit 1
fi

stop_service
start_service

after_arm_reboot="$(cat "$state_file")"
if [[ "$after_arm_reboot" != '{"state":"armed"}' ]]; then
  echo "state did not survive Unix reboot: $after_arm_reboot" >&2
  exit 1
fi

early_replay_file="$(mktemp)"
early_replay_status="$(
  curl --silent --show-error -o "$early_replay_file" -w '%{http_code}'     -X POST -H 'Idempotency-Key: too-early' "$base/consume"
)"
early_replay="$(cat "$early_replay_file")"
rm -f "$early_replay_file"
if [[ "$early_replay_status" != "409" ]] ||
   [[ "$early_replay" != '{"request":"replay","outcome":{"kind":"refused","error":"not_armed"},"current_state":"armed"}' ]]; then
  echo "refusal receipt did not survive Unix reboot: $early_replay_status $early_replay" >&2
  exit 1
fi

arm_replay="$(
  curl --silent --show-error -X POST     -H 'Idempotency-Key: arm-1' "$base/arm"
)"
if [[ "$arm_replay" != '{"request":"replay","outcome":{"kind":"applied","state":"armed"},"current_state":"armed"}' ]]; then
  echo "arm receipt did not survive Unix reboot: $arm_replay" >&2
  exit 1
fi

used="$(
  curl --silent --show-error -X POST     -H 'Idempotency-Key: consume-1' "$base/consume"
)"
if [[ "$used" != '{"request":"fresh","outcome":{"kind":"applied","state":"used"},"current_state":"used"}' ]]; then
  echo "unexpected fresh consume response: $used" >&2
  exit 1
fi

stop_service
start_service

after_consume_reboot="$(cat "$state_file")"
if [[ "$after_consume_reboot" != '{"state":"used"}' ]]; then
  echo "used state did not survive Unix reboot: $after_consume_reboot" >&2
  exit 1
fi

used_replay="$(
  curl --silent --show-error -X POST     -H 'Idempotency-Key: consume-1' "$base/consume"
)"
if [[ "$used_replay" != '{"request":"replay","outcome":{"kind":"applied","state":"used"},"current_state":"used"}' ]]; then
  echo "consume receipt did not survive Unix reboot: $used_replay" >&2
  exit 1
fi

stop_service
opam exec -- chamelon write "$image" 512 /capsule corrupt

: >"$log"
mirage/dist/statecapsule-http --port "$port" >"$log" 2>&1 &
pid=$!
sleep 1

if kill -0 "$pid" 2>/dev/null; then
  echo "service accepted a malformed persisted snapshot" >&2
  cat "$log" >&2
  exit 1
fi
wait "$pid" 2>/dev/null || true
pid=""

if ! grep -q "invalid persisted capsule snapshot" "$log"; then
  echo "service failed closed, but not for the expected snapshot validation reason" >&2
  cat "$log" >&2
  exit 1
fi

echo "MirageOS Unix durable replay/reboot smoke test: OK"
